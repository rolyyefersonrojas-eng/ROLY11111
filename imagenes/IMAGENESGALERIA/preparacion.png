  <span class="xr_tl Normal_Text" style="left: 64.44px; top: 559.99px;color:#191919;">se &nbsp;</span>
  <span class="xr_tl Normal_Text" style="left: 83.03px; top: 559.99px;color:#191919;">&nbsp;&nbsp;</span>
  <span class="xr_tl Normal_Text" style="left: 87.09px; top: 559.99px;color:#191919;">debe &nbsp;</span>
  <span class="xr_tl Normal_Text" style="left: 124.01px; top: 559.99px;color:#191919;">&nbsp;&nbsp;</span>
  <span class="xr_tl Normal_Text" style="left: 128.07px; top: 559.99px;color:#191919;">poseer &nbsp;</span>
  <span class="xr_tl Normal_Text" style="left: 177.26px; top: 559.99px;color:#191919;">&nbsp;&nbsp;</span>
  <span class="xr_tl Normal_Text" style="left: 181.32px; top: 559.99px;color:#191919;">la &nbsp;</span>
  <span class="xr_tl Normal_Text" style="left: 196.7px; top: 559.99px;color:#191919;">&nbsp;&nbsp;</span>
  <span class="xr_tl Normal_Text" style="left: 200.76px; top: 559.99px;color:#191919;">tecnología &nbsp;</span>
  <span class="xr_tl Normal_Text" style="left: 272.32px; top: 559.99px;color:#191919;">&nbsp;&nbsp;</span>
